[Unit]
Description=Andy blog rebuild (consume durable pending/dirty)
After=network-online.target docker.service
Wants=network-online.target
OnFailure=blog-rebuild-failure.service
RefuseManualStart=false

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=WWW_ROOT=/var/www/andy-y.cn
Environment=COMPOSE_DIR=/var/www/andy-blog
Environment=RUNTIME_DIR=/var/www/andy-blog/runtime/build
Environment=STATE_DIR=/var/www/andy-y.cn/state
WorkingDirectory=/var/www/andy-blog
ExecStart=/var/www/andy-blog/host/blog-rebuild.sh
Nice=5
# No Docker socket exposure to public containers — only this host unit may compose.

[Install]
WantedBy=multi-user.target
