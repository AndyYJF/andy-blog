[Unit]
Description=Andy blog reconciliation — arm pending if content may have drifted
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=RUNTIME_DIR=/var/www/andy-blog/runtime/build
# Always set pending; debounce + flock coalesce bursts. Does not skip when locked.
ExecStart=/bin/bash -c 'mkdir -p "$RUNTIME_DIR"; printf "%s\\n" "{\"event\":\"reconcile\",\"ts\":$(date +%%s),\"nonce\":\"reconcile\",\"receivedAt\":\"$(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ)\"}" >"$RUNTIME_DIR/pending"'
