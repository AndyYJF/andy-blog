# Copy to /etc/andy-blog/offbox-builder.env on the production VPS (mode 0600).
# Do not put database secrets, tokens, or private key material in this file.
ANDY_BLOG_BUILDER=offbox
OFFBOX_SSH_TARGET=root@202.61.252.176
OFFBOX_SSH_KEY=/root/.ssh/andy_blog_offbox_ed25519
# Optional jump when VPS↔builder is slow. Leave unset to keep the direct path.
# OFFBOX_SSH_JUMP=root@154.37.219.205
# OFFBOX_SSH_JUMP_KEY=/root/.ssh/andy_blog_relay_ed25519
OFFBOX_ROOT=/opt/andy-blog-offbox
OFFBOX_WORK=/opt/andy-blog-offbox/work
