# Copy to /etc/andy-blog/offbox-status-ui.env on the OFF-BOX builder (mode 0600).
# Never store this on the production VPS. Never put the real password in git.
# Public HTTPS is Caddy on build.fei.cx; Node listens on loopback only.
# Login is a WeUI password form + HttpOnly cookie. Do not use HTTP Basic.
OFFBOX_STATUS_BIND=127.0.0.1
OFFBOX_STATUS_PORT=8787
OFFBOX_STATUS_RUNTIME=/opt/andy-blog-offbox/runtime
STATUS_UI_PASSWORD_FILE=/etc/andy-blog/offbox-status-ui.password
# ALLOW_NO_AUTH=1  # local/dev escape hatch only; password is required even on loopback without this
