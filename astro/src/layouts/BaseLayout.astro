---
import CommonHead from "../components/CommonHead.astro";
import ThemeInit from "../components/ThemeInit.astro";
import SearchDialog from "../components/SearchDialog.astro";
import PageOrnaments from "../components/PageOrnaments.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  article?: boolean;
  type?: "website" | "article";
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  pageMotif?: "dn42";
}

const {
  title = "AndyYan Blog",
  description = "AndyYan 的技术博客",
  canonicalPath = "/",
  article = false,
  type = article ? "article" : "website",
  image,
  pubDate,
  updatedDate,
  noindex = false,
  jsonLd,
  pageMotif,
} = Astro.props;

const site = Astro.site ?? new URL("https://www.andy-y.cn");
const canonical = new URL(canonicalPath, site).href;
const ogImage = new URL(image || "/og-default.png", site).href;
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const navItems = [
  { href: "/archive/", label: "归档" },
  { href: "/about/", label: "关于" },
  { href: "/friends/", label: "友链" },
  { href: "/dn42/", label: "DN42" },
];

const defaultLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title.replace(/\s·\sAndyYan$/, ""),
        description,
        url: canonical,
        mainEntityOfPage: canonical,
        datePublished: pubDate?.toISOString(),
        dateModified: (updatedDate ?? pubDate)?.toISOString(),
        author: { "@type": "Person", name: "AndyYan", url: site.href },
        image: ogImage,
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "AndyYan Blog",
        url: site.href,
        description,
        author: { "@type": "Person", name: "AndyYan" },
      };

const ldPayload = jsonLd ?? defaultLd;
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="AndyYan Blog RSS" href={new URL("/rss.xml", site).href} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="AndyYan Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(ldPayload)} />

    <ThemeInit />
    <link rel="stylesheet" href="/vendor/katex/katex.min.css" />
    <CommonHead />
  </head>
  <body>
    <div data-top-sentinel aria-hidden="true"></div>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/" aria-current={currentPath === "/" ? "page" : undefined}>AndyYan</a>
        <nav class="site-nav">
          {navItems.map(({ href, label }) => (
            <a href={href} aria-current={currentPath === href ? "page" : undefined}>{label}</a>
          ))}
          <SearchDialog />
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="切换主题">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    {pageMotif === "dn42" && <PageOrnaments motif="dn42" />}

    <main class="wrap" id="main" tabindex="-1">
      <slot />
    </main>

    {article && <nav class="article-toc" data-article-toc aria-label="文章目录"></nav>}
    {article && <nav class="reading-progress" data-reading-progress aria-label="章节导航"></nav>}

    <button class="to-top" type="button" data-to-top aria-label="返回顶部">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>

    <footer class="site-footer">© {year} AndyYan</footer>

    <script>
      type Dispose = () => void;

      let generation = 0;
      let disposers: Dispose[] = [];

      function initBackToTop(): Dispose {
        const button = document.querySelector<HTMLButtonElement>("[data-to-top]");
        const sentinel = document.querySelector("[data-top-sentinel]");
        if (!button || !sentinel) return () => {};

        const observer = new IntersectionObserver(([entry]) => {
          button.toggleAttribute("data-visible", !entry.isIntersecting);
        });
        observer.observe(sentinel);

        const onClick = () => {
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
        };
        button.addEventListener("click", onClick);

        return () => {
          observer.disconnect();
          button.removeEventListener("click", onClick);
        };
      }

      async function mount() {
        const current = ++generation;
        disposers.push(initBackToTop());

        const article = document.querySelector<HTMLElement>("[data-article]");
        if (!article) return;

        const { initArticle } = await import("../scripts/article");
        if (current !== generation) return;
        disposers.push(
          initArticle(
            article,
            document.querySelector("[data-reading-progress]"),
            document.querySelector("[data-article-toc]"),
          ),
        );
      }

      function cleanup() {
        generation += 1;
        for (const dispose of disposers.splice(0)) dispose();
      }

      document.addEventListener("astro:page-load", mount);
      document.addEventListener("astro:before-swap", cleanup);
    </script>
  </body>
</html>
