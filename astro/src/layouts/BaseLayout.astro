---
import CommonHead from "../components/CommonHead.astro";
import ThemeInit from "../components/ThemeInit.astro";
import SearchDialog from "../components/SearchDialog.astro";
import PageEmblem from "../components/PageEmblem.astro";
import { activeMetaOfType } from "../lib/meta-routes";
import { ui, toUiLang } from "../i18n/ui";
import fs from "node:fs";
import path from "node:path";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  article?: boolean;
  type?: "website" | "article";
  image?: string;
  pubDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  lang?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  katex?: boolean;
}

const {
  title = "AndyYan Blog",
  description,
  canonicalPath = "/",
  article = false,
  type = article ? "article" : "website",
  image,
  pubDate,
  updatedDate,
  noindex = false,
  lang = "zh-CN",
  jsonLd,
  katex = false,
} = Astro.props;

const uiLang = toUiLang(lang);
const t = ui(lang);
const metaDescription = description ?? t.description;

const site = Astro.site ?? new URL("https://www.andy-y.cn");
const canonical = new URL(canonicalPath, site).href;
const ogImage = new URL(image || "/og-default.png", site).href;

// hreflang + language switcher: zh↔en path pairs. Dynamic pairs come from
// the i18n selection written by sync-typecho.js (astro/.cache); static
// routes pair structurally. Missing file (pre-i18n env) → zh-only behavior.
const staticLangPairs: Record<string, string> = {
  "/": "/en/",
  "/posts/": "/en/posts/",
  "/archive/": "/en/archive/",
  "/friends/": "/en/friends/",
  "/about/": "/en/about/",
};
const langPairs: Record<string, string> = { ...staticLangPairs };
// import.meta.url is unreliable under Vite bundling; try it, then cwd.
const selectionCandidates = [
  new URL("../../.cache/i18n-selection.json", import.meta.url),
  path.resolve(process.cwd(), ".cache/i18n-selection.json"),
];
for (const candidate of selectionCandidates) {
  try {
    const selection = JSON.parse(fs.readFileSync(candidate, "utf8"));
    for (const entry of selection.entries || []) {
      if (entry?.renderExpected && typeof entry.canonicalPath === "string" && entry.canonicalPath.startsWith("/en/")) {
        langPairs[entry.canonicalPath.slice(3)] = entry.canonicalPath;
      }
    }
    break;
  } catch {
    /* try next candidate */
  }
}
const currentUrlPath = Astro.url.pathname;
const normalizedPath = currentUrlPath.endsWith("/") ? currentUrlPath : `${currentUrlPath}/`;
const isEnPath = normalizedPath === "/en/" || normalizedPath.startsWith("/en/");
// en pages always have a zh counterpart (structural or source content);
// zh pages link en only when the pair actually exists.
const zhCounterpart = isEnPath ? (normalizedPath === "/en/" ? "/" : normalizedPath.slice(3)) : normalizedPath;
const enCounterpart = isEnPath ? normalizedPath : langPairs[normalizedPath];
const langSwitchPath = isEnPath ? zhCounterpart : (enCounterpart ?? "/en/");
const langSwitchLabel = isEnPath ? "中文" : "EN";
const rssPath = uiLang === "en" ? "/en/rss.xml" : "/rss.xml";
const year = new Date().getFullYear();
const buildDate = new Date().toISOString().slice(0, 10);
const currentPath = Astro.url.pathname;
const articleNavActive =
  currentPath === "/posts/" ||
  currentPath.startsWith("/posts/") ||
  /^\/page\/\d+\/?$/.test(currentPath);
const momentsNavActive =
  currentPath === "/moments/" ||
  currentPath.startsWith("/moments/");
const isPostList =
  currentPath === "/posts/" ||
  /^\/page\/\d+\/?$/.test(currentPath);
const navItems = t.nav;
const isNavActive = (href: string) => {
  if (uiLang === "en") return currentPath === href || (href !== "/dn42/" && currentPath.startsWith(href));
  if (href === "/posts/") return articleNavActive;
  if (href === "/moments/") return momentsNavActive;
  return currentPath === href;
};

// 二级分类导航条：文章列表/分页 + 分类页（详情页不显示，避免 sticky 顶栏占高）
const isEnPostList = currentPath === "/en/posts/";
const isEnCategory = currentPath.startsWith("/en/category/");
const catBarVisible = isPostList || currentPath.startsWith("/category/") || isEnPostList || isEnCategory;

// 顶栏下方的二级分类导航条；「所有文章」指向文章列表主页
const catBarItems = activeMetaOfType("category").map(({ mid, meta }) => {
  if (uiLang === "en") {
    const href = mid === 1 ? "/en/posts/" : `/en${meta.canonicalPath}`;
    return {
      href,
      label: mid === 1 ? "All posts" : meta.name?.trim() || meta.sourceSlug,
      active: mid === 1 ? isEnPostList : currentPath === href,
    };
  }
  return {
    href: mid === 1 ? "/posts/" : meta.canonicalPath,
    label: meta.name?.trim() || meta.sourceSlug,
    active: mid === 1 ? isPostList : currentPath === meta.canonicalPath,
  };
});

// 独立页的左侧页边动态徽章（文章页不渲染，保持清爽）
const emblemPage = currentPath.startsWith("/posts/") || currentPath.startsWith("/en/posts/") || /^\/page\/\d+\/?$/.test(currentPath)
  ? "posts"
  : currentPath === "/archive/" || currentPath === "/en/archive/"
    ? "archive"
    : currentPath === "/friends/" || currentPath === "/en/friends/"
      ? "friends"
      : currentPath === "/about/" || currentPath === "/en/about/"
        ? "about"
        : undefined;

const defaultLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title.replace(/\s·\sAndyYan$/, ""),
        description: metaDescription,
        url: canonical,
        mainEntityOfPage: canonical,
        datePublished: pubDate?.toISOString(),
        dateModified: (updatedDate ?? pubDate)?.toISOString(),
        author: { "@type": "Person", name: "AndyYan", url: site.href },
        image: ogImage,
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "AndyYan Blog",
        url: site.href,
        description: metaDescription,
        author: { "@type": "Person", name: "AndyYan" },
      };

const ldPayload = jsonLd ?? defaultLd;
// Escape <>& so a title/description cannot break out of the JSON-LD <script>.
const ldJson = JSON.stringify(ldPayload)
  .replace(/</g, "\\u003c")
  .replace(/>/g, "\\u003e")
  .replace(/&/g, "\\u0026");
---
<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {enCounterpart && (
      <>
        <link rel="alternate" hreflang="zh-CN" href={new URL(zhCounterpart, site).href} />
        <link rel="alternate" hreflang="en" href={new URL(enCounterpart, site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(zhCounterpart, site).href} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="AndyYan Blog RSS" href={new URL(rssPath, site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="AndyYan Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={ldJson} />

    <ThemeInit />
    {katex && <link rel="stylesheet" href="/vendor/katex/katex.min.css" />}
    <CommonHead />
  </head>
  <body class:list={[article && "reading-page"]}>
    <div data-top-sentinel aria-hidden="true"></div>
    <div class="bg-fx" aria-hidden="true"></div>
    {!article && (
      <>
        <nav class="spine" data-spine aria-label={t.spineAria}></nav>
        <div class="prog" data-prog aria-hidden="true">
          <span class="prog-label">00%</span>
          <div class="prog-track"><div class="prog-fill"></div></div>
        </div>
        {emblemPage && <PageEmblem page={emblemPage} />}
      </>
    )}
    <a class="skip-link" href="#main">{t.skipLink}</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href={t.homeHref} aria-current={currentPath === t.homeHref ? "page" : undefined} aria-label={t.homeAria}>{t.home}</a>
        <nav class="site-nav" aria-label={t.navAria}>
          <div class="site-nav-links">
            {navItems.map(({ href, label }) => (
              <a href={href} aria-current={isNavActive(href) ? "page" : undefined}>{label}</a>
            ))}
          </div>
          <details class="site-menu">
            <summary
              class="site-menu-toggle"
              role="button"
              aria-controls="site-menu-panel"
              aria-expanded="false"
              aria-label={t.menuOpen}
              data-label-open={t.menuOpen}
              data-label-close={t.menuClose}
              data-site-menu-toggle
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16"></path>
              </svg>
              <span>{t.menu}</span>
            </summary>
            <div class="site-menu-panel" id="site-menu-panel">
              {navItems.map(({ href, label }) => (
                <a href={href} aria-current={isNavActive(href) ? "page" : undefined}>{label}</a>
              ))}
            </div>
          </details>
          <SearchDialog lang={uiLang === "en" ? "en" : "zh-CN"} />
          <a class="lang-switch" href={langSwitchPath} hreflang={isEnPath ? "zh-CN" : "en"} aria-label={isEnPath ? "切换到中文" : "Switch to English"}>{langSwitchLabel}</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label={t.themeToggle}>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </nav>
      </div>
      {catBarVisible && (
        <nav class="cat-bar" aria-label={uiLang === "en" ? "Category navigation" : "分类导航"}>
          <div class="cat-bar-inner">
            {catBarItems.map((item) => (
              <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>
            ))}
          </div>
        </nav>
      )}
    </header>

    <main class="wrap page-enter" id="main" tabindex="-1" transition:name="page-main" transition:animate="none">
      <slot />
    </main>

    {article && <nav class="article-toc" data-article-toc aria-label={t.tocAria}></nav>}
    {article && <nav class="reading-progress" data-reading-progress aria-label={t.progressAria}></nav>}

    <button class="to-top" type="button" data-to-top aria-label={t.toTop}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>

    <footer class="site-footer">
      <p class="net-status">
        <span>AS4242422921 · FULL-MESH IBGP</span>
        <span>{t.nodes} · BUILD {buildDate}</span>
      </p>
      <div class="site-footer-row">
        <div class="site-footer-legal">
          <span>© {year} AndyYan</span>
          <a
            class="icp-link"
            href="https://beian.miit.gov.cn/"
            target="_blank"
            rel="noopener noreferrer"
          >皖ICP备2025089361号-1</a>
          <span class="site-uptime">
            {t.uptime} <time data-uptime datetime="2025-06-13T00:00:00+08:00">…</time>
          </span>
        </div>
        <nav aria-label={t.footerNavAria}>
          <a href={t.aboutHref}>{t.about}</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>

    <script>
      type Dispose = () => void;

      let generation = 0;
      let disposers: Dispose[] = [];

      type ScrollToTarget = (
        target: number | string | HTMLElement,
        options?: { immediate?: boolean; offset?: number },
      ) => void;

      function initBackToTop(scrollToTarget: ScrollToTarget): Dispose {
        const button = document.querySelector<HTMLButtonElement>("[data-to-top]");
        const sentinel = document.querySelector("[data-top-sentinel]");
        if (!button || !sentinel) return () => {};

        const observer = new IntersectionObserver(([entry]) => {
          button.toggleAttribute("data-visible", !entry.isIntersecting);
        });
        observer.observe(sentinel);

        const onClick = () => scrollToTarget(0);
        button.addEventListener("click", onClick);

        return () => {
          observer.disconnect();
          button.removeEventListener("click", onClick);
        };
      }

      function initSiteMenu(): Dispose {
        const details = document.querySelector<HTMLDetailsElement>(".site-menu");
        const toggle = details?.querySelector<HTMLElement>("[data-site-menu-toggle]");
        if (!details || !toggle) return () => {};

        const sync = () => {
          const expanded = details.open;
          toggle.setAttribute("aria-expanded", String(expanded));
          toggle.setAttribute("aria-label", expanded ? (toggle.dataset.labelClose || "Close navigation menu") : (toggle.dataset.labelOpen || "Open navigation menu"));
        };
        details.addEventListener("toggle", sync);
        sync();

        return () => details.removeEventListener("toggle", sync);
      }

      /* 桌面端页边导航：左侧章节索引脊 + 右侧阅读进度 */
      function initEdgeNav(scrollToTarget: ScrollToTarget): Dispose {
        const spine = document.querySelector<HTMLElement>("[data-spine]");
        const prog = document.querySelector<HTMLElement>("[data-prog]");
        if (!spine || !prog) return () => {};

        const secs = Array.from(document.querySelectorAll<HTMLElement>("main section"));
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

        // 索引脊：标签依次取 kicker → aria-label → 首个标题；
        // 首页 hero 的 kicker 太长，第一个条目收敛为 INTRO。
        // 条目太少撑不起导航（归档 2 条、关于 3 条），只在 section 充足时渲染
        let setActive: ((i: number) => void) | undefined;
        let placeMarkerAt: ((i: number) => void) | undefined;
        let marker: HTMLElement | undefined;
        if (secs.length >= 4) {
          // 悬停预览卡（共享一个浮层，内容随条目切换）
          const preview = document.createElement("div");
          preview.className = "spine-preview";
          preview.setAttribute("aria-hidden", "true");
          spine.appendChild(preview);

          // 每个章节预提取预览内容：标题 + 前三条条目；
          // 无列表型内容的章节（如 CONTACT）退化为直接文本/链接
          const previewData = secs.map((sec) => {
            const title =
              sec.querySelector("h1, h2")?.textContent?.trim() ?? "";
            let entries = Array.from(
              sec.querySelectorAll("h3, .post-card a, li a"),
            )
              .map((el) => el.textContent?.trim().replace(/\s+/g, " ") ?? "")
              .filter((t) => t.length > 0 && t.length < 60);
            if (entries.length === 0) {
              entries = Array.from(sec.querySelectorAll("p, a"))
                .filter(
                  (el) =>
                    !el.closest(".section-heading") &&
                    !(el instanceof Element && /kicker/.test(el.className)),
                )
                .map((el) => el.textContent?.trim().replace(/\s+/g, " ") ?? "")
                .filter((t) => t.length > 0 && t.length < 60);
            }
            return { title, entries: entries.slice(0, 3), total: entries.length };
          });

          const showPreview = (i: number, anchor: HTMLElement) => {
            const data = previewData[i];
            if (!data) return;
            preview.textContent = "";
            const heading = document.createElement("h5");
            heading.textContent =
              data.title +
              (data.total ? ` · ${String(data.total).padStart(2, "0")}` : "");
            preview.appendChild(heading);
            if (data.entries.length > 0) {
              const list = document.createElement("ul");
              for (const t of data.entries) {
                const li = document.createElement("li");
                li.textContent = t;
                list.appendChild(li);
              }
              preview.appendChild(list);
            }
            preview.style.top = `${anchor.offsetTop}px`;
            // 重启动画：条目间直接切换时也能重新弹出
            preview.removeAttribute("data-show");
            void preview.offsetWidth;
            preview.setAttribute("data-show", "");
          };
          const hidePreview = () => preview.removeAttribute("data-show");
          spine.addEventListener("mouseleave", hidePreview);

          const links = secs.map((sec, i) => {
            const kicker = sec.querySelector(
              ".section-heading p, [class*=kicker], header p",
            );
            let label =
              kicker?.textContent?.trim() ||
              sec.getAttribute("aria-label")?.trim() ||
              sec.querySelector("h2, h3")?.textContent?.trim() ||
              `SEC 0${i + 1}`;
            if (i === 0 && label.length > 14) label = "INTRO";
            const a = document.createElement("a");
            if (!sec.id) sec.id = `section-${i + 1}`;
            a.href = `#${sec.id}`;
            const text = document.createElement("span");
            text.textContent = label;
            const tick = document.createElement("i");
            tick.className = "tick";
            a.append(text, tick);
            a.addEventListener("click", (event) => {
              event.preventDefault();
              // 立即反馈，避免等平滑滚动结束才高亮
              activeIdx = i;
              setActive?.(i);
              scrollToTarget(sec, { immediate: reduce });
            });
            a.addEventListener("mouseenter", () => showPreview(i, a));
            a.addEventListener("focus", () => showPreview(i, a));
            a.addEventListener("blur", hidePreview);
            spine.appendChild(a);
            return a;
          });

          // 滑动标记：外层负责位置（回弹滑动），内层圆点负责跳跃形变与弧线
          marker = document.createElement("i");
          marker.className = "spine-marker";
          const markerDot = document.createElement("i");
          markerDot.className = "spine-marker-dot";
          marker.appendChild(markerDot);
          spine.appendChild(marker);
          let lastMarkerY: number | undefined;
          placeMarkerAt = (i: number) => {
            const a = links[i];
            if (!marker || !a) return;
            const y = a.offsetTop + a.offsetHeight / 2;
            if (lastMarkerY !== undefined && y !== lastMarkerY) {
              // 位置真的变化才触发果冻跳（初始定位不跳）
              markerDot.classList.remove("spine-hop");
              void markerDot.offsetWidth;
              markerDot.classList.add("spine-hop");
            }
            lastMarkerY = y;
            marker.style.transform = `translateY(${y}px)`;
          };
          setActive = (current: number) => {
            links.forEach((a, i) => a.toggleAttribute("data-active", i === current));
            placeMarkerAt(current);
          };
          setActive(0);
        }

        // 阅读进度 + 索引脊激活（滚动计算，避免 IO 窄带探测不到末尾章节）
        const fill = prog.querySelector<HTMLElement>(".prog-fill");
        const progLabel = prog.querySelector<HTMLElement>(".prog-label");
        let activeIdx = 0;
        const onScroll = () => {
          const el = document.documentElement;
          const range = el.scrollHeight - el.clientHeight;
          const p = range > 0 ? Math.min(1, Math.max(0, el.scrollTop / range)) : 0;
          if (fill) fill.style.height = `${p * 100}%`;
          if (progLabel)
            progLabel.textContent = `${String(Math.round(p * 100)).padStart(2, "0")}%`;

          if (setActive) {
            // 探测线 30%：须小于最短 section 高度（~381px），
            // 否则点击跳转后下一节也进入探测区，激活态会越位
            const probe = el.clientHeight * 0.3;
            let idx = 0;
            secs.forEach((sec, i) => {
              if (sec.getBoundingClientRect().top <= probe) idx = i;
            });
            // 滚到底部时直接激活最后一节（短章节可能永远进不了探测线）
            if (range > 0 && el.scrollTop >= range - 2) idx = secs.length - 1;
            if (idx !== activeIdx) {
              activeIdx = idx;
              setActive(idx);
            }
          }
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        return () => {
          window.removeEventListener("scroll", onScroll);
        };
      }

      /* 关于页时间线：滚入视口时逐条入场 */
      function initTimelineReveal(): Dispose {
        const tl = document.querySelector<HTMLElement>(".about-timeline");
        if (!tl) return () => {};
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return () => {};
        tl.classList.add("tl-armed");
        const io = new IntersectionObserver(
          ([entry]) => {
            if (entry.isIntersecting) {
              tl.classList.add("tl-in");
              io.disconnect();
            }
          },
          { threshold: 0.25 },
        );
        io.observe(tl);
        return () => io.disconnect();
      }

      /* 按访问者国家码隐藏指定入口（如 Telegram 对中国大陆隐藏）。
         失败一律保持显示（fail-open）；结果存 sessionStorage 避免换页重复请求 */
      function initGeoHide(): Dispose {
        const targets = Array.from(
          document.querySelectorAll<HTMLElement>("[data-geo-hide]"),
        );
        if (targets.length === 0) return () => {};

        const apply = (cc: string) => {
          for (const el of targets) {
            const codes = (el.getAttribute("data-geo-hide") ?? "").split(/\s+/);
            if (codes.includes(cc)) el.remove();
          }
        };

        let cached: string | null = null;
        try {
          cached = sessionStorage.getItem("geo-cc");
        } catch {}
        if (cached !== null) {
          if (cached) apply(cached);
          return () => {};
        }

        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 4000);
        fetch("https://ipwho.is/", { signal: controller.signal })
          .then((r) => (r.ok ? r.json() : Promise.reject(new Error("geo http"))))
          .then((data) => {
            const cc =
              data && data.success !== false && typeof data.country_code === "string"
                ? data.country_code
                : "";
            try {
              sessionStorage.setItem("geo-cc", cc);
            } catch {}
            if (cc) apply(cc);
          })
          .catch(() => {
            /* fail-open：查询失败保持卡片可见 */
          })
          .finally(() => clearTimeout(timer));

        return () => {
          clearTimeout(timer);
          controller.abort();
        };
      }

      /* 页脚运行时长：自 2025-06-13（+08:00）建站起实时走秒 */
      function initUptime(): Dispose {
        const el = document.querySelector<HTMLElement>("[data-uptime]");
        if (!el) return () => {};
        const epoch = new Date("2025-06-13T00:00:00+08:00").getTime();
        const pad = (n: number) => String(n).padStart(2, "0");
        const render = () => {
          const diff = Math.max(0, Date.now() - epoch);
          const days = Math.floor(diff / 86400000);
          const h = Math.floor(diff / 3600000) % 24;
          const m = Math.floor(diff / 60000) % 60;
          const s = Math.floor(diff / 1000) % 60;
          const years = Math.floor(days / 365);
          const dayPart = years > 0 ? `${years} 年 ${days % 365} 天` : `${days} 天`;
          el.textContent = `${dayPart} ${h} 时 ${pad(m)} 分 ${pad(s)} 秒`;
        };
        render();
        const timer = setInterval(render, 1000);
        return () => clearInterval(timer);
      }

      async function mount() {
        const current = ++generation;
        const { initSmoothScroll, scrollToTarget } = await import(
          "../scripts/smooth-scroll"
        );
        if (current !== generation) return;

        disposers.push(initSmoothScroll());
        disposers.push(initBackToTop(scrollToTarget));
        disposers.push(initSiteMenu());
        disposers.push(initEdgeNav(scrollToTarget));
        disposers.push(initTimelineReveal());
        disposers.push(initGeoHide());
        disposers.push(initUptime());

        const article = document.querySelector<HTMLElement>("[data-article]");
        if (article) {
          const { initArticle } = await import("../scripts/article");
          if (current !== generation) return;
          disposers.push(
            initArticle(
              article,
              document.querySelector("[data-reading-progress]"),
              document.querySelector("[data-article-toc]"),
            ),
          );
        }

        const momentsRoot =
          document.querySelector<HTMLElement>("[data-moments-index]") ||
          document.querySelector<HTMLElement>(".moments-detail");
        if (momentsRoot) {
          const [{ initLightbox }, { initMomentExpand, initCopyLinks }] = await Promise.all([
            import("../scripts/lightbox"),
            import("../scripts/moments"),
          ]);
          if (current !== generation) return;
          disposers.push(initLightbox(momentsRoot));
          disposers.push(initMomentExpand(momentsRoot));
          disposers.push(initCopyLinks(momentsRoot));
        }
      }

      function cleanup() {
        generation += 1;
        for (const dispose of disposers.splice(0)) dispose();
      }

      document.addEventListener("astro:page-load", mount);
      document.addEventListener("astro:before-swap", cleanup);
    </script>
  </body>
</html>
