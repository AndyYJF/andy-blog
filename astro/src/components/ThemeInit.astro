---
// Must render before site CSS so the first paint already has the right theme.
---
<script is:inline>
  (() => {
    const RIPPLE_MS = 520;
    const root = document.documentElement;

    const readTheme = () => {
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') return saved;
      } catch {}
      return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    };

    const applyTheme = (doc, theme) => {
      doc.documentElement.dataset.theme = theme;
    };

    const syncButtons = (theme) => {
      for (const button of document.querySelectorAll('[data-theme-toggle]')) {
        button.setAttribute('aria-pressed', String(theme === 'dark'));
      }
    };

    applyTheme(document, readTheme());

    // Inline head scripts may run again after a ClientRouter swap; keep one controller.
    const prev = window.__andyThemeController;
    if (prev?.abort) {
      try { prev.abort.abort(); } catch {}
    }
    const abort = new AbortController();
    const { signal } = abort;
    window.__andyThemeController = { abort };
    window.__andyThemeControllerInstalled = true;

    let current = null;

    const endRipple = () => {
      if (current) window.clearTimeout(current.watchdog);
      current = null;
      root.classList.remove('theme-ripple');
      root.style.removeProperty('--theme-ripple-x');
      root.style.removeProperty('--theme-ripple-y');
      root.style.removeProperty('--theme-ripple-r');
      if (!root.getAttribute('style')) root.removeAttribute('style');
    };

    const skipRipple = () => {
      try { current?.transition.skipTransition(); } catch {}
      endRipple();
    };

    // 圆形扩散：旧画面停在原地，新主题从按钮中心扩开（见 global.css 的 theme-ripple-reveal）。
    // 圆心/半径一律用百分比传给 clip-path：Chromium 在非整数 DPR 下会把 px 裁剪坐标
    // 按设备像素解释，导致圆心偏向左上；百分比相对伪元素自身盒子解析，不受影响。
    const runRipple = (button, apply) => {
      const rect = button.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const w = window.innerWidth;
      const h = window.innerHeight;
      const radius = Math.hypot(Math.max(x, w - x), Math.max(y, h - y));
      // circle() 的百分比半径以 sqrt(w²+h²)/√2 为基准
      const radiusPct = (radius / (Math.hypot(w, h) / Math.SQRT2)) * 100 + 1;

      root.style.setProperty('--theme-ripple-x', `${(x / w) * 100}%`);
      root.style.setProperty('--theme-ripple-y', `${(y / h) * 100}%`);
      root.style.setProperty('--theme-ripple-r', `${radiusPct}%`);
      root.classList.add('theme-ripple');

      let transition;
      try {
        transition = document.startViewTransition(apply);
      } catch {
        endRipple();
        apply();
        return;
      }

      current = {
        transition,
        watchdog: window.setTimeout(skipRipple, RIPPLE_MS + 400),
      };
      transition.finished
        .catch(() => {})
        .finally(() => {
          if (current?.transition === transition) endRipple();
        });
    };

    document.addEventListener('astro:before-swap', (event) => {
      applyTheme(event.newDocument, root.dataset.theme === 'dark' ? 'dark' : 'light');
    }, { signal });

    document.addEventListener('astro:page-load', () => {
      skipRipple();
      syncButtons(root.dataset.theme === 'dark' ? 'dark' : 'light');
    }, { signal });

    document.addEventListener('click', (event) => {
      const button = event.target instanceof Element
        ? event.target.closest('[data-theme-toggle]')
        : null;
      if (!button) return;

      if (current) skipRipple();

      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const apply = () => {
        applyTheme(document, next);
        syncButtons(next);
        try { localStorage.setItem('theme', next); } catch {}
      };

      if (
        typeof document.startViewTransition !== 'function' ||
        matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        apply();
        return;
      }

      runRipple(button, apply);
    }, { signal });
  })();
</script>
