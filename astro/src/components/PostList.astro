---
/**
 * Shared post list card markup for home / taxonomies / pagination.
 */
import { categoryTone } from "../lib/category-tone";
import { loadMetaRouteMap } from "../lib/meta-routes";

interface PostItem {
  title: string;
  canonicalPath: string;
  pubDate: Date;
  description?: string;
  cover?: string;
  categories: { mid: number; name: string; slug?: string }[];
}

interface Props {
  posts: PostItem[];
  emptyText?: string;
  lang?: string;
}

const { posts, emptyText = "暂无文章", lang = "zh-CN" } = Astro.props;
const isEn = lang.startsWith("en");
const metaRoutes = loadMetaRouteMap();
---
{posts.length === 0 ? (
  <p class="muted">{emptyText}</p>
) : (
  <ul class="post-list">
    {posts.map((post) => {
      const displayCategories = post.categories.filter((category) => category.mid !== 1);
      return (
        <li class="post-card">
          {post.cover && (
            <a class="card-cover" href={post.canonicalPath} tabindex="-1" aria-hidden="true">
              <img
                src={post.cover}
                alt=""
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </a>
          )}
          <div class="card-body">
            <time datetime={post.pubDate.toISOString()}>
              {post.pubDate.toISOString().slice(0, 10)}
            </time>
            <h2><a href={post.canonicalPath}>{post.title}</a></h2>
            {post.description && <p class="card-summary">{post.description}</p>}
            {displayCategories.length > 0 && (
              <p class="card-meta">
                {displayCategories.map((category, index) => {
                  const tone = categoryTone(category.slug);
                  const route = metaRoutes[String(category.mid)];
                  const zhHref = route && route.state === "active" ? route.canonicalPath : undefined;
                  const href = zhHref && isEn ? `/en${zhHref}` : zhHref;
                  return (
                    <>
                      {index > 0 && <span class="cat-sep" aria-hidden="true"> / </span>}
                      {href ? (
                        <a class:list={["cat", tone && `tone-${tone}`]} href={href}>{category.name}</a>
                      ) : (
                        <span class:list={["cat", tone && `tone-${tone}`]}>{category.name}</span>
                      )}
                    </>
                  );
                })}
              </p>
            )}
          </div>
        </li>
      );
    })}
  </ul>
)}

<script>
  const observed = new WeakSet<HTMLImageElement>();
  function initCoverFallbacks() {
    document.querySelectorAll<HTMLImageElement>(".card-cover img").forEach((image) => {
      const removeFailedCover = () => image.closest(".card-cover")?.remove();
      if (image.complete && image.naturalWidth === 0) {
        removeFailedCover();
      } else if (!observed.has(image)) {
        observed.add(image);
        image.addEventListener("error", removeFailedCover, { once: true });
      }
    });
  }
  initCoverFallbacks();
  document.addEventListener("astro:page-load", initCoverFallbacks);
</script>
