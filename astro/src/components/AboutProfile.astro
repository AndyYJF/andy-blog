---
import { profile } from '../data/profile';

interface Props {
  lang?: 'zh' | 'en';
}
const { lang = 'zh' } = Astro.props;
const en = lang === 'en';

const copy = {
  lead: en
    ? 'An ordinary undergraduate studying Artificial Intelligence at [Sichuan University](https://www.scu.edu.cn/) (class of 2025).'
    : '一个普通的[四川大学](https://www.scu.edu.cn/)人工智能专业在读生（2025 级）。',
  intro: en
    ? 'I\u2019m an ESFP who enjoys tinkering with AI, computer networks, VPSes and other little things \u2014 turning \u201cwill this even run?\u201d into \u201chuh, it actually runs.\u201d I don\u2019t know much, and even that only shallowly (just kidding).'
    : '本人是ESFP，平时喜欢折腾AI、计算机网络、VPS等小东西，享受把「这玩意儿能跑吗」折腾成「居然真跑起来了」的过程。虽然会的不多，但是学的也很浅（雾',
  blog: en
    ? 'This blog is my technical ledger: network experiments, self-hosted services and postmortems, all written up as reproducible records. Hope to meet more friends~'
    : '这个博客是我的技术账本，网络实验、自托管服务和故障复盘都会整理成可以复现的记录。希望交到更多朋友~',
  elsewhere: en ? 'Elsewhere' : '在别处',
  timeline: en ? 'Timeline' : '时间线',
  setup: en ? 'Setup' : '装备清单',
  thisSite: en ? 'This site' : '这个站点',
  timelineItems: en
    ? [
        ['2025-06-13', 'Site launched, powered by Typecho'],
        ['2026-01-23', 'First post published (an OMV troubleshooting log)'],
        ['2026-02-19', 'Started documenting DN42 experiments'],
        ['2026-08-17', 'Migrated the whole site to static Astro; Typecho now only serves as the CMS'],
      ]
    : [
        ['2025-06-13', '建站，由 Typecho 驱动'],
        ['2026-01-23', '发布第一篇文章（OMV 排障记录）'],
        ['2026-02-19', '开始记录 DN42 实践'],
        ['2026-08-17', '全站迁移到 Astro 静态化，Typecho 退居幕后做 CMS'],
      ],
  setupItems: en
    ? [
        ['Portal', 'Korami', 'korami.andy-y.cn', 'https://korami.andy-y.cn/', 'Service navigation and status page'],
        ['Lab network', 'DN42 four nodes', 'AS4242422921', '/dn42/', 'LAX / FRA / HKG / TYO full-mesh iBGP'],
        ['Servers', 'VPS cluster', '', '', '1Panel + OpenResty, everything containerized'],
        ['Storage', 'OMV NAS', '', '', 'Backups and media library'],
      ]
    : [
        ['门户', 'Korami', 'korami.andy-y.cn', 'https://korami.andy-y.cn/', '服务导航与状态页'],
        ['实验网络', 'DN42 四节点', 'AS4242422921', '/dn42/', 'LAX / FRA / HKG / TYO full-mesh iBGP'],
        ['服务器', 'VPS 集群', '', '', '1Panel + OpenResty，服务全容器化'],
        ['存储', 'OMV NAS', '', '', '承担备份与媒体库'],
      ],
  siteP1: en
    ? 'Pages are statically generated with Astro. Posts still come from Typecho as the content source, and Pagefind provides on-demand on-site search.'
    : '页面由 Astro 静态生成，文章仍以 Typecho 为内容来源，并通过 Pagefind 提供按需加载的站内搜索。',
  siteP2: en
    ? 'This site uses Umami for analytics: it writes no cookies and collects no personally identifiable information. All data is anonymized aggregates, used only to understand page traffic.'
    : '本站使用 Umami 进行访问统计：它不写入 Cookie、不收集任何可识别个人身份的信息，所有数据均为匿名聚合，仅用于了解页面的访问情况。',
};

// The lead paragraph carries an inline link; render it as HTML built from the copy string.
const leadHtml = copy.lead.replace(
  /\[(.+?)\]\((https?:\/\/.+?)\)/g,
  '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>',
);
---
<div class="about-profile">
  <p class="about-lead" set:html={leadHtml} />
  <p>{copy.intro}</p>
  <p>{copy.blog}</p>

  <section class="about-section" aria-labelledby="about-elsewhere-title">
    <header class="about-section-heading">
      <p class="profile-kicker">ELSEWHERE</p>
      <h2 id="about-elsewhere-title">{copy.elsewhere}</h2>
    </header>
    <ul class="about-social">
      <li>
        <a class="s-wide" href={`mailto:${profile.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-10 6L2 7"></path>
          </svg>
          <span class="s-label">Email</span>
          <span class="s-handle">{profile.email}</span>
        </a>
      </li>
      <li>
        <a href="https://peer.andy-y.cn/" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5h14M5 5v14M19 5v14M5 19h14M5 19L19 5"></path>
            <circle cx="5" cy="5" r="2.1" fill="currentColor" stroke="none"></circle>
            <circle cx="19" cy="5" r="2.1" fill="currentColor" stroke="none"></circle>
            <circle cx="5" cy="19" r="2.1" fill="currentColor" stroke="none"></circle>
            <circle cx="19" cy="19" r="2.1" fill="currentColor" stroke="none"></circle>
          </svg>
          <span class="s-label">Peer With Me</span>
          <span class="s-handle">AS4242422921</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="about-section" aria-labelledby="about-timeline-title">
    <header class="about-section-heading">
      <p class="profile-kicker">TIMELINE</p>
      <h2 id="about-timeline-title">{copy.timeline}</h2>
    </header>
    <ol class="about-timeline">
      {copy.timelineItems.map(([date, text]) => (
        <li>
          <time>{date}</time>
          <span>{text}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="about-section" aria-labelledby="about-setup-title">
    <header class="about-section-heading">
      <p class="profile-kicker">SETUP</p>
      <h2 id="about-setup-title">{copy.setup}</h2>
    </header>
    <ul class="about-setup">
      {copy.setupItems.map(([k, name, linkText, linkHref, desc]) => (
        <li>
          <span class="k">{k}</span>
          <strong>{name}</strong>
          <small>
            {linkHref && (
              <a href={linkHref} target={linkHref.startsWith('http') ? '_blank' : undefined} rel={linkHref.startsWith('http') ? 'noopener noreferrer' : undefined}>{linkText}</a>
            )}
            {linkHref && ' · '}{desc}
          </small>
        </li>
      ))}
    </ul>
  </section>

  <section class="about-section" aria-labelledby="about-site-title">
    <header class="about-section-heading">
      <p class="profile-kicker">THIS SITE</p>
      <h2 id="about-site-title">{copy.thisSite}</h2>
    </header>
    <p>{copy.siteP1}</p>
    <p class="muted">{copy.siteP2}</p>
  </section>
</div>
