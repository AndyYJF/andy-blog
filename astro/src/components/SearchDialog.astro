---
/**
 * Lazy Pagefind UI.
 *
 * First click opens <dialog>; CSS/JS load only then. Mount Promise is cached.
 * ClientRouter may strip head CSS on swap — reopen re-injects if needed.
 * lang="en" searches the /en/-only index at /en/pagefind (dual-index build).
 */
interface Props {
  lang?: string;
}
const { lang = "zh-CN" } = Astro.props;
const isEn = lang.startsWith("en");
const strings = isEn
  ? {
      open: "Search posts",
      title: "Site search",
      subtitle: "Search translated posts by title or body",
      close: "Close",
      loading: "Loading search…",
      failed: "Search failed to load. Close and retry.",
      escHint: "close",
      kHint: "open search",
      placeholder: "Search posts…",
      clear: "Clear",
      loadMore: "Load more",
      zero: "No results for [SEARCH_TERM]",
      many: "[COUNT] results",
      one: "1 result",
    }
  : {
      open: "搜索文章",
      title: "站内搜索",
      subtitle: "按标题或正文关键词查找",
      close: "关闭",
      loading: "正在加载搜索…",
      failed: "搜索加载失败，关闭后重试",
      escHint: "关闭",
      kHint: "打开搜索",
      placeholder: "搜索文章…",
      clear: "清除",
      loadMore: "加载更多",
      zero: "没有找到「[SEARCH_TERM]」",
      many: "[COUNT] 条结果",
      one: "1 条结果",
    };
---
<button
  type="button"
  class="search-toggle"
  data-search-open
  aria-haspopup="dialog"
  aria-controls="site-search"
  aria-label={strings.open}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
</button>

<dialog id="site-search" class="search-dialog" data-search-dialog data-search-lang={isEn ? "en" : "zh"} aria-labelledby="site-search-title">
  <div class="search-dialog-chrome">
    <div class="search-dialog-heading">
      <strong id="site-search-title">{strings.title}</strong>
      <p>{strings.subtitle}</p>
    </div>
    <button type="button" class="search-close" data-search-close aria-label={strings.close}>{strings.close}</button>
  </div>
  <div id="pagefind-container" data-pagefind-root></div>
  <p class="search-hint muted" data-search-status role="status" hidden></p>
  <div class="search-dialog-footer" aria-hidden="true">
    <span><kbd>Esc</kbd> {strings.escHint}</span>
    <span><kbd>Ctrl / ⌘ K</kbd> {strings.kHint}</span>
  </div>
</dialog>

<script>
  type PagefindUICtor = new (opts: Record<string, unknown>) => { destroy?: () => void };
  declare global {
    interface Window {
      PagefindUI?: PagefindUICtor;
      __andySearch?: {
        loadPromise: Promise<void> | null;
        mounted: boolean;
        ui: { destroy?: () => void } | null;
      };
    }
  }

  const SEARCH_STRINGS = {
    zh: {
      loading: '正在加载搜索…',
      failed: '搜索加载失败，关闭后重试',
      placeholder: '搜索文章…',
      clear: '清除',
      loadMore: '加载更多',
      searchLabel: '站内搜索',
      zero: '没有找到「[SEARCH_TERM]」',
      many: '[COUNT] 条结果',
      one: '1 条结果',
    },
    en: {
      loading: 'Loading search…',
      failed: 'Search failed to load. Close and retry.',
      placeholder: 'Search posts…',
      clear: 'Clear',
      loadMore: 'Load more',
      searchLabel: 'Site search',
      zero: 'No results for [SEARCH_TERM]',
      many: '[COUNT] results',
      one: '1 result',
    },
  };

  function currentLang() {
    const dialog = document.querySelector('[data-search-dialog]');
    return dialog instanceof HTMLElement && dialog.dataset.searchLang === 'en' ? 'en' : 'zh';
  }

  const state = (window.__andySearch ??= {
    loadPromise: null as Promise<void> | null,
    mounted: false,
    ui: null as { destroy?: () => void } | null,
  });

  const CSS_HREF = '/pagefind/pagefind-ui.css';
  const JS_HREF = '/pagefind/pagefind-ui.js';

  function ensureCss(): void {
    if (document.querySelector(`link[href="${CSS_HREF}"]`)) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = CSS_HREF;
    document.head.append(link);
  }

  function loadAssets(): Promise<void> {
    if (state.loadPromise) return state.loadPromise;
    state.loadPromise = new Promise<void>((resolve, reject) => {
      ensureCss();
      if (window.PagefindUI) {
        resolve();
        return;
      }
      const existing = document.querySelector(`script[src="${JS_HREF}"]`);
      if (existing) {
        existing.addEventListener('load', () => resolve(), { once: true });
        existing.addEventListener('error', () => reject(new Error('pagefind script failed')), { once: true });
        return;
      }
      const script = document.createElement('script');
      script.src = JS_HREF;
      script.async = true;
      script.addEventListener('load', () => resolve(), { once: true });
      script.addEventListener('error', () => {
        state.loadPromise = null;
        reject(new Error('pagefind script failed'));
      }, { once: true });
      document.head.append(script);
    });
    return state.loadPromise;
  }

  function mountUi(): void {
    if (state.mounted && state.ui) return;
    const root = document.querySelector('[data-pagefind-root]');
    if (!root || !window.PagefindUI) return;
    root.replaceChildren();
    // Dual index: zh at /pagefind (en pages stashed during indexing), en at
    // /en/pagefind (en-only). The UI bundle itself is language-agnostic and
    // always loaded from the zh asset path, which exists on every release.
    const lang = currentLang();
    const strings = SEARCH_STRINGS[lang];
    state.ui = new window.PagefindUI({
      element: '[data-pagefind-root]',
      bundlePath: lang === 'en' ? '/en/pagefind/' : '/pagefind/',
      showImages: false,
      showSubResults: false,
      excerptLength: 20,
      pageSize: 8,
      language: lang,
      translations: {
        language: lang,
        placeholder: strings.placeholder,
        clear_search: strings.clear,
        load_more: strings.loadMore,
        search_label: strings.searchLabel,
        zero_results: strings.zero,
        many_results: strings.many,
        one_result: strings.one,
      },
    });
    state.mounted = true;
  }

  async function openSearch(): Promise<void> {
    const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
    const status = document.querySelector<HTMLElement>('[data-search-status]');
    if (!dialog) return;
    if (!dialog.open) {
      // Force a frame so @starting-style open animation can run.
      dialog.showModal();
    }

    const strings = SEARCH_STRINGS[currentLang()];
    if (status) {
      status.hidden = false;
      status.textContent = strings.loading;
    }
    try {
      ensureCss();
      await loadAssets();
      mountUi();
      if (status) status.hidden = true;
      const input = dialog.querySelector<HTMLInputElement>('input');
      input?.focus();
    } catch {
      state.loadPromise = null;
      state.mounted = false;
      state.ui = null;
      if (status) {
        status.hidden = false;
        status.textContent = strings.failed;
      }
    }
  }

  function closeSearch(): void {
    const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
    if (!dialog?.open) return;
    // Native close still participates in allow-discrete transitions when supported.
    dialog.close();
  }

  function onDialogClick(event: MouseEvent): void {
    // Clicks on the ::backdrop surface target the <dialog> itself.
    const dialog = event.currentTarget;
    if (dialog instanceof HTMLDialogElement && event.target === dialog) {
      closeSearch();
    }
  }

  function onClick(event: MouseEvent): void {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest('[data-search-open]')) {
      event.preventDefault();
      void openSearch();
      return;
    }
    if (target.closest('[data-search-close]')) {
      closeSearch();
    }
  }

  function onKeydown(event: KeyboardEvent): void {
    if (event.key === 'Escape') closeSearch();
    if ((event.key === 'k' || event.key === 'K') && (event.metaKey || event.ctrlKey)) {
      event.preventDefault();
      void openSearch();
    }
  }

  // Focus trap-ish: when dialog closes, return focus to opener if still around.
  function onDialogClose(): void {
    document.querySelector<HTMLButtonElement>('[data-search-open]')?.focus();
  }

  function wireDialog(dialog: Element | null): void {
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.addEventListener('close', onDialogClose);
    dialog.addEventListener('click', onDialogClick);
  }

  function bind(): void {
    document.addEventListener('click', onClick);
    document.addEventListener('keydown', onKeydown);
    wireDialog(document.querySelector('[data-search-dialog]'));
  }

  // Module scripts re-run on ClientRouter navigations in Astro — guard duplicates
  // via abortable pattern: only one set of document-level listeners via flag.
  if (!(window as unknown as { __andySearchBound?: boolean }).__andySearchBound) {
    (window as unknown as { __andySearchBound?: boolean }).__andySearchBound = true;
    bind();
  }

  // After soft navigations, dialog node is new — re-attach listeners.
  document.addEventListener('astro:page-load', () => {
    wireDialog(document.querySelector('[data-search-dialog]'));
    // Force remount into the new container next open.
    state.mounted = false;
    state.ui = null;
  });
</script>
