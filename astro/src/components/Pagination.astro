---
interface Props {
  current: number;
  totalPages: number;
  basePath?: string;
  /** When set, page 2+ uses `${pagedPrefix}${n}/` instead of `/page/${n}/`. */
  pagedPrefix?: string;
}

const { current, totalPages, basePath = "/", pagedPrefix } = Astro.props;
if (totalPages <= 1) return;

const hrefFor = (n: number) => {
  if (n <= 1) return basePath;
  if (pagedPrefix) return `${pagedPrefix}${n}/`;
  return `/page/${n}/`;
};
---
<nav class="pagination" aria-label="分页">
  {current > 1 ? (
    <a href={hrefFor(current - 1)} rel="prev">上一页</a>
  ) : (
    <span class="muted" aria-disabled="true">上一页</span>
  )}
  <span class="pagination-status">
    {current} / {totalPages}
  </span>
  {current < totalPages ? (
    <a href={hrefFor(current + 1)} rel="next">下一页</a>
  ) : (
    <span class="muted" aria-disabled="true">下一页</span>
  )}
</nav>
