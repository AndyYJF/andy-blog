---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comments from "../../components/Comments.astro";
import { getCollection, render } from "astro:content";
import { categoryTone } from "../../lib/category-tone";
import { loadMetaRouteMap } from "../../lib/meta-routes";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const katex = remarkPluginFrontmatter.hasKatex === true;
const description = post.data.description;
const metaRoutes = loadMetaRouteMap();
const displayCategories = post.data.categories
  .filter((category) => category.mid !== 1)
  .map((category) => {
    const route = metaRoutes[String(category.mid)];
    return {
      ...category,
      tone: categoryTone(category.slug),
      href: route && route.state === "active" ? route.canonicalPath : undefined,
    };
  });
---
<BaseLayout
  title={`${post.data.title} · AndyYan`}
  description={description}
  canonicalPath={post.data.canonicalPath}
  article
  type="article"
  image={post.data.cover}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  katex={katex}
>
  <article class="prose" data-article data-pagefind-body>
    <header class="entry-header">
      <div transition:name="page-title" transition:animate="none">
        {displayCategories.length > 0 && (
          <p class="entry-kicker" aria-label="文章分类">
            {displayCategories.map((category, index) => (
              <>
                {index > 0 && <span class="cat-sep"> / </span>}
                {category.href ? (
                  <a
                    class:list={["cat", category.tone && `tone-${category.tone}`]}
                    href={category.href}
                  >{category.name}</a>
                ) : (
                  <span
                    class:list={["cat", category.tone && `tone-${category.tone}`]}
                  >{category.name}</span>
                )}
              </>
            ))}
          </p>
        )}
        <h1>{post.data.title}</h1>
      </div>
      <p class="entry-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toISOString().slice(0, 10)}
        </time>
      </p>
    </header>
    <Content />
  </article>
  <Comments commentKey={post.data.commentKey} entryWritable={post.data.allowComment} />
</BaseLayout>
