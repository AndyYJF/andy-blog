---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comments from "../../components/Comments.astro";
import { getCollection, render } from "astro:content";
import { categoryTone } from "../../lib/category-tone";
import { loadMetaRouteMap } from "../../lib/meta-routes";
import { adjacentPosts, relatedPosts, sortPosts } from "../../lib/posts";
import {
  countCharacters,
  dayKey,
  formatCount,
  readingMinutes,
  showUpdatedDate,
} from "../../lib/reading-meta";

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("posts"));
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, posts },
  }));
}

const { post, posts } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const katex = remarkPluginFrontmatter.hasKatex === true;
const description = post.data.description;
const metaRoutes = loadMetaRouteMap();
const displayCategories = post.data.categories
  .filter((category) => category.mid !== 1)
  .map((category) => {
    const route = metaRoutes[String(category.mid)];
    return {
      ...category,
      tone: categoryTone(category.slug),
      href: route && route.state === "active" ? route.canonicalPath : undefined,
    };
  });
const { prev, next } = adjacentPosts(posts, post.id);
const neighborIds = new Set([prev?.id, next?.id]);
const related = relatedPosts(posts.filter((item) => !neighborIds.has(item.id)), post, 3);
const currentTopics = new Set([
  ...post.data.categories.filter((category) => category.mid !== 1),
  ...post.data.tags,
].map((topic) => topic.mid));
const characters = countCharacters(post.body ?? "");
const minutes = readingMinutes(characters);
const publishedDay = dayKey(post.data.pubDate);
const updated = showUpdatedDate(post.data.pubDate, post.data.updatedDate);
const sharedTopics = (item) => [...new Set([
  ...item.data.categories.filter((category) => category.mid !== 1),
  ...item.data.tags,
].filter((topic) => currentTopics.has(topic.mid)).map((topic) => topic.name))].slice(0, 2).join(' · ');
---
<BaseLayout
  title={`${post.data.title} · AndyYan`}
  description={description}
  canonicalPath={post.data.canonicalPath}
  article
  type="article"
  image={post.data.cover}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  katex={katex}
>
  <article class="prose reading-prose" data-article data-pagefind-body>
    <header class="entry-header">
      <div transition:name="page-title" transition:animate="none">
        {displayCategories.length > 0 && (
          <p class="entry-kicker" aria-label="文章分类">
            {displayCategories.map((category, index) => (
              <>
                {index > 0 && <span class="cat-sep"> / </span>}
                {category.href ? (
                  <a
                    class:list={["cat", category.tone && `tone-${category.tone}`]}
                    href={category.href}
                  >{category.name}</a>
                ) : (
                  <span
                    class:list={["cat", category.tone && `tone-${category.tone}`]}
                  >{category.name}</span>
                )}
              </>
            ))}
          </p>
        )}
        <h1>{post.data.title}</h1>
      </div>
      <p class="entry-meta">
        <time datetime={post.data.pubDate.toISOString()}>{publishedDay}</time>
        <span class="entry-meta-sep" aria-hidden="true">·</span>
        <span>预计 {minutes} 分钟</span>
        <span class="entry-meta-sep" aria-hidden="true">·</span>
        <span>{formatCount(characters)} 字</span>
        {updated && (
          <>
            <span class="entry-meta-sep" aria-hidden="true">·</span>
            <time datetime={post.data.updatedDate.toISOString()}>更新于 {dayKey(post.data.updatedDate)}</time>
          </>
        )}
      </p>
    </header>
    <Content />
  </article>

    <nav class="post-footer-nav" aria-labelledby="continue-reading-title">
      <div class="post-footer-heading">
        <h2 id="continue-reading-title">继续阅读</h2>
        <a href="/posts/">全部文章 <span aria-hidden="true">→</span></a>
      </div>
      {(prev || next) && (
        <div class:list={["post-adjacent", (!prev || !next) && "is-single"]} aria-label="相邻文章">
          {prev ? (
            <a class="post-adjacent-link is-prev" href={prev.data.canonicalPath}>
              <span class="post-adjacent-label">← 上一篇 · 更早</span>
              <span class="post-adjacent-title">{prev.data.title}</span>
              <time class="post-adjacent-date" datetime={prev.data.pubDate.toISOString()}>{prev.data.pubDate.toISOString().slice(0, 10)}</time>
            </a>
          ) : (
            <span class="post-adjacent-link is-prev is-empty" aria-hidden="true"></span>
          )}
          {next ? (
            <a class="post-adjacent-link is-next" href={next.data.canonicalPath}>
              <span class="post-adjacent-label">下一篇 · 较新 →</span>
              <span class="post-adjacent-title">{next.data.title}</span>
              <time class="post-adjacent-date" datetime={next.data.pubDate.toISOString()}>{next.data.pubDate.toISOString().slice(0, 10)}</time>
            </a>
          ) : (
            <span class="post-adjacent-link is-next is-empty" aria-hidden="true"></span>
          )}
        </div>
      )}
      {related.length > 0 && (
        <div class="post-related">
          <h3 class="post-related-label">相近主题</h3>
          <ul class="post-related-list">
            {related.map((item) => (
              <li>
                <div class="post-related-entry">
                  <a href={item.data.canonicalPath}>{item.data.title}</a>
                  <small class="post-related-topics">共同主题：{sharedTopics(item)}</small>
                </div>
                <time datetime={item.data.pubDate.toISOString()}>
                  {item.data.pubDate.toISOString().slice(0, 10)}
                </time>
              </li>
            ))}
          </ul>
        </div>
      )}
    </nav>

  <Comments commentKey={post.data.commentKey} entryWritable={post.data.allowComment} />
</BaseLayout>
