---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import Pagination from "../../components/Pagination.astro";
import { getCollection } from "astro:content";
import { pageSlice } from "../../lib/posts";

const all = await getCollection("posts");
const { posts, current, totalPages } = pageSlice(all, 1);
---
<BaseLayout
  title="文章 · AndyYan"
  description="AndyYan 的技术文章、部署记录与故障复盘"
  canonicalPath="/posts/"
>
  <div class="post-index" data-post-index>
    <header class="page-heading">
      <p class="profile-kicker">WRITING / {all.length}</p>
      <h1>文章</h1>
      <p class="muted">技术笔记、部署过程与问题复盘</p>
    </header>
    <PostList posts={posts.map((post) => ({
      title: post.data.title,
      canonicalPath: post.data.canonicalPath,
      pubDate: post.data.pubDate,
      description: post.data.description,
      cover: post.data.cover,
      categories: post.data.categories,
    }))} />
    <Pagination current={current} totalPages={totalPages} basePath="/posts/" />
  </div>
</BaseLayout>
