---
import BaseLayout from "../layouts/BaseLayout.astro";
import Comments from "../components/Comments.astro";
import AboutProfile from "../components/AboutProfile.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages
    .filter((page) => page.data.canonicalPath !== "/friends/")
    .map((page) => {
      const segments = page.data.canonicalPath.replace(/^\/|\/$/g, "").split("/");
      return {
        params: { page: segments.join("/") || undefined },
        props: { page },
      };
    });
}

const { page } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(page);
const katex = remarkPluginFrontmatter.hasKatex === true;

const isAbout = page.data.canonicalPath === "/about/";
const description = isAbout
  ? "关于 AndyYan：网络实践、自托管项目与技术记录。"
  : `${page.data.title} · AndyYan 的技术博客`;
---
<BaseLayout
  title={`${page.data.title} · AndyYan`}
  description={description}
  canonicalPath={page.data.canonicalPath}
  article={!isAbout}
  type="website"
  pubDate={page.data.pubDate}
  updatedDate={page.data.updatedDate}
  katex={katex}
>
  <article class="prose" data-article data-pagefind-body>
    <header class="entry-header">
      {isAbout && <p class="profile-kicker">ABOUT / WHO</p>}
      <h1 transition:name="page-title" transition:animate="none">{page.data.title}</h1>
    </header>
    {isAbout ? <AboutProfile /> : <Content />}
  </article>
  <Comments commentKey={page.data.commentKey} entryWritable={page.data.allowComment} />
</BaseLayout>
