---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostList from "../../../components/PostList.astro";
import { getCollection } from "astro:content";
import { sortEnPosts } from "../../../lib/posts";
import { ui } from "../../../i18n/ui";

const t = ui("en");
const posts = sortEnPosts(await getCollection("enPosts"));
---
<BaseLayout
  title="Posts · AndyYan"
  description="AndyYan's technical posts, deployment logs and postmortems — English translations"
  canonicalPath="/en/posts/"
  lang="en"
>
  <h1 transition:name="page-title" transition:animate="none">Posts</h1>
  <p class="muted">Technical notes, deployment walkthroughs and postmortems, translated from Chinese</p>
  <PostList posts={posts.map((post) => ({
    title: post.data.title,
    canonicalPath: post.data.canonicalPath,
    pubDate: post.data.sourcePublishedAt,
    description: post.data.description,
    cover: post.data.cover,
    categories: post.data.categories,
  }))} emptyText={t.emptyPosts} />
</BaseLayout>
