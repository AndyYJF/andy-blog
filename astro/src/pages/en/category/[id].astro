---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostList from "../../../components/PostList.astro";
import { getCollection } from "astro:content";
import { activeMetaOfType } from "../../../lib/meta-routes";
import { sortEnPosts } from "../../../lib/posts";
import { categoryNameEn } from "../../../i18n/ui";

export async function getStaticPaths() {
  return activeMetaOfType("category").map(({ mid, meta }) => ({
    params: { id: meta.routeId },
    props: { mid, meta },
  }));
}

const { mid, meta } = Astro.props;
const all = sortEnPosts(await getCollection("enPosts"));
const posts = all.filter((p) => p.data.categories.some((c) => c.mid === mid));
const titleName =
  categoryNameEn[mid] || meta.name?.trim() ||
  posts[0]?.data.categories.find((c) => c.mid === mid)?.name ||
  meta.sourceSlug;
---
<BaseLayout
  title={`${titleName} · Category · AndyYan`}
  description={`Translated posts in category ${titleName}`}
  canonicalPath={`/en${meta.canonicalPath}`}
  lang="en"
>
  <h1 transition:name="page-title" transition:animate="none">{titleName}</h1>
  <p class="muted">Category · {posts.length} translated</p>
  <PostList
    lang="en"
    emptyText="No translated posts in this category yet"
    posts={posts.map((p) => ({
      title: p.data.title,
      canonicalPath: p.data.canonicalPath,
      pubDate: p.data.sourcePublishedAt,
      description: p.data.description,
      cover: p.data.cover,
      categories: p.data.categories,
    }))}
  />
</BaseLayout>
