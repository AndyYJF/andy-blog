---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { getCollection } from "astro:content";
import { sortPosts } from "../lib/posts";
import { profile } from "../data/profile";

const all = await getCollection("posts");
const latestPosts = sortPosts(all).slice(0, 3);
const description = "AndyYan 的个人主页：网络实践、自托管项目与技术文章。";
const site = Astro.site ?? new URL("https://www.andy-y.cn");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: "AndyYan 的个人主页",
  url: new URL("/", site).href,
  description,
  mainEntity: {
    "@type": "Person",
    name: profile.name,
    url: new URL("/", site).href,
    email: `mailto:${profile.email}`,
    description: profile.intro,
    knowsAbout: ["BGP", "DN42", "VPS", "Self-hosting", "Astro"],
  },
};
---
<BaseLayout
  title="AndyYan · 网络与自托管实践"
  description={description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <div class="profile-home" data-profile-home>
    <section id="intro" class="profile-hero" aria-labelledby="profile-title">
      <div class="hero-text">
        <p class="profile-kicker">{profile.eyebrow}</p>
        <h1 id="profile-title" transition:name="page-title" transition:animate="none">{profile.name}</h1>
        <p class="profile-role">{profile.role}</p>
        <p class="profile-intro">{profile.intro}</p>
      </div>

      <a class="hero-topology topo-card" href="/dn42/" aria-label="DN42 网络拓扑，点击查看网络详情" data-topo-card>
        <svg viewBox="0 0 280 158" role="img" aria-label="DN42 四节点全互联拓扑：洛杉矶、法兰克福、香港、东京" data-topo-svg>
          <defs>
            <pattern id="topo-dot-grid" width="14" height="14" patternUnits="userSpaceOnUse">
              <circle class="topo-dots" cx="2" cy="2" r="1"></circle>
            </pattern>
          </defs>
          <rect width="280" height="158" fill="url(#topo-dot-grid)"></rect>
          <path class="topo-arc" data-edge="lax-fra" d="M30 80 Q 78 30 132 42"></path>
          <path class="topo-arc" data-edge="lax-hkg" d="M30 80 Q 118 104 210 58"></path>
          <path class="topo-arc topo-arc-faint" data-edge="lax-tyo" d="M30 80 Q 138 134 250 96"></path>
          <path class="topo-arc" data-edge="fra-hkg" d="M132 42 Q 172 26 210 58"></path>
          <path class="topo-arc topo-arc-faint" data-edge="fra-tyo" d="M132 42 Q 196 22 250 96"></path>
          <path class="topo-arc" data-edge="hkg-tyo" d="M210 58 Q 236 72 250 96"></path>
          <g data-topo-packets></g>
          <g class="topo-node-g" data-node="lax">
            <circle class="topo-hit" cx="30" cy="80" r="11"></circle>
            <circle class="topo-node topo-pulse" cx="30" cy="80" r="3.4"></circle>
            <text class="topo-label" x="30" y="98" text-anchor="middle">LAX</text>
          </g>
          <g class="topo-node-g" data-node="fra">
            <circle class="topo-hit" cx="132" cy="42" r="11"></circle>
            <circle class="topo-node topo-pulse" cx="132" cy="42" r="3.4" style="animation-delay:.6s"></circle>
            <text class="topo-label" x="132" y="60" text-anchor="middle">FRA</text>
          </g>
          <g class="topo-node-g" data-node="hkg">
            <circle class="topo-hit" cx="210" cy="58" r="11"></circle>
            <circle class="topo-node topo-pulse" cx="210" cy="58" r="3.4" style="animation-delay:1.2s"></circle>
            <text class="topo-label" x="210" y="76" text-anchor="middle">HKG</text>
          </g>
          <g class="topo-node-g" data-node="tyo">
            <circle class="topo-hit" cx="250" cy="96" r="11"></circle>
            <circle class="topo-node topo-pulse" cx="250" cy="96" r="3.4" style="animation-delay:1.8s"></circle>
            <text class="topo-label" x="250" y="114" text-anchor="middle">TYO</text>
          </g>
        </svg>
        <span class="topo-caption">
          <span>DN42 · AS4242422921</span>
          <span class="topo-status" data-topo-status aria-live="polite">FULL-MESH / 4 节点</span>
        </span>
      </a>

      <ul class="profile-links" aria-label="快捷入口">
        <li>
          <a href="/posts/">
            <span>阅读文章</span>
            <small>{all.length} 篇技术记录</small>
          </a>
        </li>
        <li>
          <a href="/dn42/">
            <span>DN42 网络</span>
            <small>ASN 4242422921</small>
          </a>
        </li>
      </ul>
    </section>

    <section id="latest" class="profile-section home-latest" aria-labelledby="latest-title">
      <header class="section-heading section-heading-split">
        <div>
          <p>LATEST WRITING</p>
          <h2 id="latest-title">最近文章</h2>
        </div>
        <a class="section-more" href="/posts/">全部文章<span aria-hidden="true"> →</span></a>
      </header>
      <PostList posts={latestPosts.map((post) => ({
        title: post.data.title,
        canonicalPath: post.data.canonicalPath,
        pubDate: post.data.pubDate,
        description: post.data.description,
        cover: post.data.cover,
        categories: post.data.categories,
      }))} />
    </section>

    <section id="projects" class="profile-section" aria-labelledby="projects-title">
      <header class="section-heading">
        <div>
          <p>SELECTED WORK</p>
          <h2 id="projects-title">项目与实践</h2>
        </div>
      </header>
      <div class="project-grid">
        {profile.projects.map((project) => (
          <article class="project-card">
            <p class="project-marker">{project.marker}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <a href={project.href}>{project.linkLabel}<span aria-hidden="true"> →</span></a>
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="profile-contact" aria-labelledby="contact-title">
      <div>
        <p class="profile-kicker">CONTACT</p>
        <h2 id="contact-title">保持联系</h2>
      </div>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </section>
  </div>
</BaseLayout>

<script>
  import {
    TOPO_PACKET_SPEED,
    advanceOffsetDist,
    clampFrameDt,
    packetPhase,
    packetPointDistance,
  } from "../lib/topo-packet-progress";

  /* 首页 DN42 拓扑卡：指针倾斜 + 高光、边巡航数据包、节点探针 */
  {
    type TopoWin = Window & {
      __andyTopoBound?: boolean;
      __andyTopoDispose?: () => void;
    };
    const win = window as TopoWin;
    const NODES: Record<string, { label: string; city: string; x: number; y: number }> = {
      lax: { label: "LAX", city: "洛杉矶", x: 30, y: 80 },
      fra: { label: "FRA", city: "法兰克福", x: 132, y: 42 },
      hkg: { label: "HKG", city: "香港", x: 210, y: 58 },
      tyo: { label: "TYO", city: "东京", x: 250, y: 96 },
    };
    /* 六条 full-mesh 边的二次贝塞尔控制点（与 SVG 初始路径一致） */
    const EDGE_DEFS = [
      { a: "lax", b: "fra", cx: 78, cy: 30 },
      { a: "lax", b: "hkg", cx: 118, cy: 104 },
      { a: "lax", b: "tyo", cx: 138, cy: 134 },
      { a: "fra", b: "hkg", cx: 172, cy: 26 },
      { a: "fra", b: "tyo", cx: 196, cy: 22 },
      { a: "hkg", b: "tyo", cx: 236, cy: 72 },
    ];
    /* 各节点缓慢漂移的振幅 / 角速度 / 相位（viewBox 单位，周期 12~17s） */
    const DRIFT: Record<string, { ax: number; ay: number; wx: number; wy: number; ph: number }> = {
      lax: { ax: 2.4, ay: 1.8, wx: 0.5, wy: 0.37, ph: 0 },
      fra: { ax: 2.0, ay: 2.6, wx: 0.43, wy: 0.55, ph: 2.1 },
      hkg: { ax: 2.7, ay: 1.9, wx: 0.37, wy: 0.49, ph: 4.0 },
      tyo: { ax: 2.2, ay: 2.3, wx: 0.52, wy: 0.41, ph: 5.6 },
    };
    const SVG_NS = "http://www.w3.org/2000/svg";

    function initTopoCard(): () => void {
      const card = document.querySelector<HTMLElement>("[data-topo-card]");
      const svg = card?.querySelector<SVGSVGElement>("[data-topo-svg]");
      if (!card || !svg) return () => {};
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const fine = matchMedia("(pointer: fine)").matches;
      const cleanups: Array<() => void> = [];

      /* 指针倾斜 + 跟随高光 */
      if (!reduce && fine) {
        // topo-enter 入场动画 fill:both 会压住内联 transform，首次交互时摘掉
        let enterCleared = false;
        const onMove = (e: PointerEvent) => {
          if (!enterCleared) {
            card.style.animation = "none";
            enterCleared = true;
          }
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          card.style.transform = `perspective(640px) rotateX(${((0.5 - py) * 4).toFixed(2)}deg) rotateY(${((px - 0.5) * 5).toFixed(2)}deg)`;
          card.style.setProperty("--gx", `${(px * 100).toFixed(1)}%`);
          card.style.setProperty("--gy", `${(py * 100).toFixed(1)}%`);
        };
        const onLeave = () => {
          card.style.transform = "";
        };
        card.addEventListener("pointermove", onMove);
        card.addEventListener("pointerleave", onLeave);
        cleanups.push(() => {
          card.removeEventListener("pointermove", onMove);
          card.removeEventListener("pointerleave", onLeave);
        });
      }

      /* 节点缓慢漂移，边与数据包每帧随动 */
      let raf = 0;
      if (!reduce) {
        const layer = svg.querySelector("[data-topo-packets]");
        layer?.replaceChildren();
        const nodeEls = new Map(
          Object.keys(NODES).map((key) => {
            const g = svg.querySelector<SVGGElement>(`.topo-node-g[data-node="${key}"]`);
            return [
              key,
              {
                dot: g?.querySelector<SVGCircleElement>(".topo-node"),
                hit: g?.querySelector<SVGCircleElement>(".topo-hit"),
                label: g?.querySelector<SVGTextElement>(".topo-label"),
              },
            ];
          }),
        );
        const edges = Array.from(svg.querySelectorAll<SVGPathElement>(".topo-arc")).map((p) => {
          const [a, b] = (p.dataset.edge ?? "").split("-");
          const def = EDGE_DEFS.find((d) => d.a === a && d.b === b);
          return { el: p, a, b, cx: def?.cx ?? 0, cy: def?.cy ?? 0 };
        });
        const packets = edges.map((e, i) => {
          const c = document.createElementNS(SVG_NS, "circle");
          c.setAttribute("class", "topo-packet");
          c.setAttribute("r", "1.7");
          layer?.appendChild(c);
          const measured = e.el.getTotalLength();
          const refLen = Number.isFinite(measured) && measured >= 1e-3 ? measured : 1;
          return {
            path: e.el,
            el: c,
            refLen,
            offsetDist: (i / edges.length) * refLen,
            reverse: i % 2 === 1,
          };
        });
        const driftOf = (key: string, t: number) => {
          const n = NODES[key];
          const d = DRIFT[key];
          return {
            x: n.x + d.ax * Math.sin(t * d.wx + d.ph),
            y: n.y + d.ay * Math.cos(t * d.wy + d.ph * 1.7),
          };
        };
        let last: number | undefined;
        let t = 0;
        const tick = (now: number) => {
          const dt = last === undefined ? 0 : clampFrameDt(now, last);
          last = now;
          t += dt;
          const P: Record<string, { x: number; y: number }> = {};
          for (const key of Object.keys(NODES)) {
            const p = driftOf(key, t);
            P[key] = p;
            const els = nodeEls.get(key);
            const cx = p.x.toFixed(2);
            const cy = p.y.toFixed(2);
            els?.dot?.setAttribute("cx", cx);
            els?.dot?.setAttribute("cy", cy);
            els?.hit?.setAttribute("cx", cx);
            els?.hit?.setAttribute("cy", cy);
            els?.label?.setAttribute("x", cx);
            els?.label?.setAttribute("y", (p.y + 18).toFixed(2));
          }
          for (const e of edges) {
            const A = P[e.a];
            const B = P[e.b];
            // 控制点跟随两端点的平均漂移，保持曲线形态不变
            const cx = e.cx + (A.x - NODES[e.a].x + (B.x - NODES[e.b].x)) / 2;
            const cy = e.cy + (A.y - NODES[e.a].y + (B.y - NODES[e.b].y)) / 2;
            e.el.setAttribute(
              "d",
              `M${A.x.toFixed(2)} ${A.y.toFixed(2)} Q ${cx.toFixed(2)} ${cy.toFixed(2)} ${B.x.toFixed(2)} ${B.y.toFixed(2)}`,
            );
          }
          for (const pk of packets) {
            pk.offsetDist = advanceOffsetDist(pk.offsetDist, dt, TOPO_PACKET_SPEED);
            pk.offsetDist = ((pk.offsetDist % pk.refLen) + pk.refLen) % pk.refLen;
            const len = pk.path.getTotalLength();
            const u = packetPhase(pk.offsetDist, len, pk.refLen);
            if (u === null) continue;
            const pt = pk.path.getPointAtLength(packetPointDistance(u, len, pk.reverse));
            pk.el.setAttribute("cx", pt.x.toFixed(1));
            pk.el.setAttribute("cy", pt.y.toFixed(1));
          }
          raf = requestAnimationFrame(tick);
        };
        raf = requestAnimationFrame(tick);
        cleanups.push(() => {
          cancelAnimationFrame(raf);
          raf = 0;
          layer?.replaceChildren();
        });
      }

      /* 节点探针：高亮相连边、淡出其余、状态栏切换 */
      const status = card.querySelector<HTMLElement>("[data-topo-status]");
      const defaultStatus = status?.textContent ?? "";
      const groups = Array.from(svg.querySelectorAll<SVGGElement>(".topo-node-g"));
      const setProbe = (key: string | null) => {
        card.toggleAttribute("data-probe", !!key);
        for (const g of groups) g.classList.toggle("is-hot", g.dataset.node === key);
        for (const p of svg.querySelectorAll<SVGPathElement>(".topo-arc")) {
          const hot = !!key && (p.dataset.edge ?? "").includes(key);
          p.classList.toggle("is-hot", hot);
          p.classList.toggle("is-dim", !!key && !hot);
        }
        if (status) {
          status.textContent = key
            ? `${NODES[key].label} · ${NODES[key].city} · 实验节点`
            : defaultStatus;
        }
      };
      for (const g of groups) {
        const enter = () => setProbe(g.dataset.node ?? null);
        const leave = () => setProbe(null);
        g.addEventListener("pointerenter", enter);
        g.addEventListener("pointerleave", leave);
        cleanups.push(() => {
          g.removeEventListener("pointerenter", enter);
          g.removeEventListener("pointerleave", leave);
        });
      }
      // 兜底：指针离开整卡时复位探针（子元素的 leave 在个别浏览器/场景下可能漏发）
      const cardLeave = () => setProbe(null);
      card.addEventListener("pointerleave", cardLeave);
      cleanups.push(() => card.removeEventListener("pointerleave", cardLeave));

      return () => cleanups.forEach((fn) => fn());
    }

    const start = () => {
      win.__andyTopoDispose?.();
      win.__andyTopoDispose = initTopoCard();
    };
    if (!win.__andyTopoBound) {
      win.__andyTopoBound = true;
      document.addEventListener("astro:page-load", start);
      document.addEventListener("astro:before-swap", () => {
        win.__andyTopoDispose?.();
        win.__andyTopoDispose = undefined;
      });
    }
    // page-load 可能已先于模块执行派发；仅在卡存在时 dispose-then-init
    if (document.querySelector("[data-topo-card]")) start();
  }
</script>
