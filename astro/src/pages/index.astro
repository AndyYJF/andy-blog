---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import HomeNetwork from "../components/HomeNetwork.astro";
import AndySignature from "../components/AndySignature.astro";
import { getCollection } from "astro:content";
import { sortPosts } from "../lib/posts";
import { profile } from "../data/profile";

const all = await getCollection("posts");
const latestPosts = sortPosts(all).slice(0, 3);
const description = "AndyYan 的个人主页：网络实践、自托管项目与技术文章。";
const site = Astro.site ?? new URL("https://www.andy-y.cn");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: "AndyYan 的个人主页",
  url: new URL("/", site).href,
  description,
  mainEntity: {
    "@type": "Person",
    name: profile.name,
    url: new URL("/", site).href,
    email: `mailto:${profile.email}`,
    description: profile.intro,
    knowsAbout: ["BGP", "DN42", "VPS", "Self-hosting", "Astro"],
  },
};
---
<BaseLayout
  title="AndyYan · 网络与自托管实践"
  description={description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <div class="profile-home" data-profile-home>
    <section id="intro" class="profile-hero" aria-labelledby="profile-title">
      <div class="hero-text">
        <p class="profile-kicker">{profile.eyebrow}</p>
        <h1 id="profile-title" transition:name="page-title" transition:animate="none"><AndySignature /></h1>
        <p class="profile-role">{profile.role}</p>
        <p class="profile-intro">{profile.intro}</p>
      </div>

      <HomeNetwork />

      <ul class="profile-links" aria-label="快捷入口">
        <li>
          <a href="/posts/">
            <span>阅读文章</span>
            <small>{all.length} 篇技术记录</small>
          </a>
        </li>
        <li>
          <a href="/dn42/">
            <span>DN42 网络</span>
            <small>ASN 4242422921</small>
          </a>
        </li>
      </ul>
    </section>

    <section id="latest" class="profile-section home-latest" aria-labelledby="latest-title">
      <header class="section-heading section-heading-split">
        <div>
          <p>LATEST WRITING</p>
          <h2 id="latest-title">最近文章</h2>
        </div>
        <a class="section-more" href="/posts/">全部文章<span aria-hidden="true"> →</span></a>
      </header>
      <PostList posts={latestPosts.map((post) => ({
        title: post.data.title,
        canonicalPath: post.data.canonicalPath,
        pubDate: post.data.pubDate,
        description: post.data.description,
        cover: post.data.cover,
        categories: post.data.categories,
      }))} />
    </section>

    <section id="projects" class="profile-section" aria-labelledby="projects-title">
      <header class="section-heading">
        <div>
          <p>SELECTED WORK</p>
          <h2 id="projects-title">项目与实践</h2>
        </div>
      </header>
      <div class="project-grid">
        {profile.projects.map((project) => (
          <article class="project-card">
            <p class="project-marker">{project.marker}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <a href={project.href}>{project.linkLabel}<span aria-hidden="true"> →</span></a>
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="profile-contact" aria-labelledby="contact-title">
      <div>
        <p class="profile-kicker">CONTACT</p>
        <h2 id="contact-title">保持联系</h2>
      </div>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </section>
  </div>
</BaseLayout>
