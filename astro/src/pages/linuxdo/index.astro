---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { linuxdoPublic } from "../../data/linuxdo-public";

const challengeUrl = `${linuxdoPublic.apiOrigin}${linuxdoPublic.challengePath}`;
const claimUrl = `${linuxdoPublic.apiOrigin}${linuxdoPublic.claimPath}`;
---
<BaseLayout
  title="LinuxDo 邀请 · AndyYan"
  description="完成本地计算验证后领取 LinuxDo 邀请链接。旧说明文仍保留在文章区。"
  canonicalPath="/linuxdo/"
  type="website"
  noindex={true}
>
  <article class="linuxdo-page prose" data-linuxdo-page data-article>
    <header class="linuxdo-intro">
      <p class="linuxdo-eyebrow">LINUXDO / 邀请</p>
      <h1 transition:name="page-title" transition:animate="none">领取邀请</h1>
      <p class="linuxdo-lead">
        浏览器完成本地计算验证后即可领取当前邀请链接。说明与记录仍在
        <a href="/posts/linuxdo/">原文章</a>。
      </p>
    </header>

    <section class="linuxdo-panel" aria-labelledby="linuxdo-claim-title">
      <h2 id="linuxdo-claim-title">计算验证</h2>
      <p class="linuxdo-status" data-linuxdo-status role="status" aria-live="polite">正在准备验证…</p>

      {/* 纯展示：读屏由上方 role=status 承担，这里 aria-hidden */}
      <div class="linuxdo-pow" data-linuxdo-pow data-state="idle" aria-hidden="true">
        <p class="pow-head">
          <span class="pow-label">SHA-256</span>
          <span class="pow-target">目标 <b data-pow-target>0000</b></span>
        </p>
        <div class="pow-digits" data-pow-digits>
          {/* 数字位在模板里渲染，才能拿到 Astro 作用域属性；
              运行时插入的节点不会带 data-astro-cid-*，样式会全部失效 */}
          {Array.from({ length: 10 }).map(() => <span class="pow-rest">·</span>)}
        </div>
        <div class="pow-rail"><span class="pow-rail-fill"></span></div>
      </div>

      <button type="button" class="linuxdo-claim-btn" data-linuxdo-claim disabled>
        获取邀请链接
      </button>
      <p class="linuxdo-result" data-linuxdo-result hidden>
        <a data-linuxdo-link href="#" rel="noopener noreferrer" target="_blank"></a>
        <span data-linuxdo-note class="linuxdo-note" hidden></span>
      </p>
    </section>
  </article>
</BaseLayout>

<script define:vars={{ challengeUrl, claimUrl }}>
  const root = document.querySelector("[data-linuxdo-page]");
  if (root) {
    const btn = root.querySelector("[data-linuxdo-claim]");
    const status = root.querySelector("[data-linuxdo-status]");
    const result = root.querySelector("[data-linuxdo-result]");
    const link = root.querySelector("[data-linuxdo-link]");
    const note = root.querySelector("[data-linuxdo-note]");
    const pow = root.querySelector("[data-linuxdo-pow]");
    const powDigits = root.querySelector("[data-pow-digits]");
    const powTarget = root.querySelector("[data-pow-target]");

    let solution = null;

    const setStatus = (text) => {
      if (status) status.textContent = text || "";
    };

    const toHex = (buffer) =>
      [...new Uint8Array(buffer)].map((b) => b.toString(16).padStart(2, "0")).join("");

    const sha256Hex = async (value) => {
      const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
      return toHex(digest);
    };

    const meets = (hex, difficulty) => hex.startsWith("0".repeat(difficulty));

    /* 展示层：只读映出求解过程，不参与判定 */
    const POW_DIGITS = powDigits?.children.length || 10;
    let difficulty = 4;
    let paintSeq = 0;

    const setPowState = (state) => {
      if (pow) pow.dataset.state = state;
    };

    const renderDigits = (hex, solved) => {
      if (!powDigits) return;
      const cells = powDigits.children;
      const shown = (hex || "").slice(0, POW_DIGITS).padEnd(POW_DIGITS, "·");
      let zeros = 0;
      while (zeros < shown.length && shown[zeros] === "0") zeros += 1;
      const lit = Math.min(zeros, difficulty);
      for (let i = 0; i < POW_DIGITS; i += 1) {
        const cell = cells[i];
        if (!cell) continue;
        if (cell.textContent !== shown[i]) cell.textContent = shown[i];
        const cls =
          solved && i < difficulty ? "pow-hit" : i < lit ? "pow-zero" : "pow-rest";
        if (cell.className !== cls) cell.className = cls;
      }
    };

    const resetPow = () => {
      paintSeq += 1;
      setPowState("idle");
      renderDigits("", false);
    };

    /* 求解循环每 200 次 nonce 回调一次；这里补算一次摘要用于显示。
       展示摘要是异步的，用序号丢弃过期的回调，避免旧值覆盖新值。 */
    const paintProgress = async (salt, nonce) => {
      if (!powDigits) return;
      const seq = ++paintSeq;
      setPowState("running");
      const hex = await sha256Hex(`${salt}:${nonce}`);
      if (seq !== paintSeq) return;
      renderDigits(hex, false);
    };

    const finishPow = async (salt, nonce) => {
      const seq = ++paintSeq;
      const hex = await sha256Hex(`${salt}:${nonce}`);
      setPowState("solved");
      if (seq !== paintSeq) return;
      renderDigits(hex, true);
    };

    const solvePow = async (salt, difficulty, onProgress) => {
      let nonce = 0;
      let lastPaint = 0;
      while (nonce < 50_000_000) {
        const hex = await sha256Hex(`${salt}:${nonce}`);
        if (meets(hex, difficulty)) return String(nonce);
        nonce += 1;
        if (nonce - lastPaint >= 200) {
          lastPaint = nonce;
          onProgress?.(nonce);
          await new Promise((r) => setTimeout(r, 0));
        }
      }
      throw new Error("pow_timeout");
    };

    const prepare = async () => {
      solution = null;
      if (btn) btn.disabled = true;
      resetPow();
      setStatus("正在获取验证题…");
      const chRes = await fetch(challengeUrl, { headers: { Accept: "application/json" } });
      const ch = await chRes.json().catch(() => ({}));
      if (!chRes.ok || !ch?.ok) {
        const map = {
          not_configured: "服务端尚未配置邀请，请稍后再试。",
          rate_limited: "请求太频繁，请稍后再试。",
        };
        setStatus(map[ch?.error] || (chRes.status === 429 ? "请求太频繁，请稍后再试。" : "获取验证题失败，请刷新重试。"));
        setPowState("error");
        return;
      }
      difficulty = Number(ch.difficulty) || difficulty;
      if (powTarget) powTarget.textContent = "0".repeat(difficulty);
      setStatus("正在计算…");
      const nonce = await solvePow(ch.salt, ch.difficulty, (n) => {
        setStatus(`正在计算…（${n.toLocaleString("zh-CN")}）`);
        paintProgress(ch.salt, n);
      });
      solution = { id: ch.id, nonce };
      await finishPow(ch.salt, nonce);
      setStatus("验证已完成，可以领取。");
      if (btn) btn.disabled = false;
    };

    btn?.addEventListener("click", async () => {
      if (!solution) {
        setStatus("请等待计算完成。");
        return;
      }
      btn.disabled = true;
      setStatus("正在领取…");
      result.hidden = true;
      try {
        const res = await fetch(claimUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(solution),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data?.ok || typeof data.inviteUrl !== "string") {
          const map = {
            not_configured: "服务端尚未配置邀请，请稍后再试。",
            pow_failed: "验证未通过，正在重新计算…",
            challenge_missing: "验证已失效，正在重新计算…",
            challenge_used: "验证已使用，正在重新计算…",
            challenge_expired: "验证已过期，正在重新计算…",
            missing_pow: "验证不完整，正在重新计算…",
          };
          setStatus(map[data?.error] || (res.status === 429 ? "请求太频繁，请稍后再试。" : "领取失败，正在重新计算…"));
          await prepare();
          return;
        }
        link.href = data.inviteUrl;
        link.textContent = data.inviteUrl;
        if (data.note) {
          note.hidden = false;
          note.textContent = data.note;
        } else {
          note.hidden = true;
          note.textContent = "";
        }
        result.hidden = false;
        setStatus("领取成功，请尽快使用。");
        solution = null;
      } catch {
        setStatus("网络异常，正在重新准备…");
        await prepare();
      }
    });

    prepare().catch(() => {
      setStatus("初始化失败，请刷新页面。");
      setPowState("error");
    });
  }
</script>

<style>
  .linuxdo-page { padding: 1rem 0 2.5rem; max-width: 40rem; }
  .linuxdo-eyebrow {
    margin: 0 0 1rem;
    color: var(--accent-text);
    font: 0.67rem/1.5 var(--font-mono);
    letter-spacing: 0.13em;
  }
  .linuxdo-lead { margin: 1rem 0 0; color: var(--muted); font-size: 0.95rem; line-height: 1.7; }
  .linuxdo-page :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: color-mix(in srgb, var(--muted) 60%, transparent);
    transition: text-decoration-color var(--t-fast) var(--ease);
  }
  .linuxdo-page :global(a:hover) {
    text-decoration-color: var(--accent-text);
  }
  .linuxdo-panel {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .linuxdo-panel h2 { margin: 0 0 1rem; font-size: 1.05rem; }
  .linuxdo-claim-btn {
    display: inline-flex;
    align-items: center;
    margin-top: 1rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  .linuxdo-claim-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .linuxdo-claim-btn:not(:disabled):hover { border-color: var(--accent-text); color: var(--accent-text); }
  .linuxdo-status { margin: 0; color: var(--muted); font-size: 0.85rem; min-height: 1.4em; }
  .linuxdo-result { margin: 1rem 0 0; word-break: break-all; }
  .linuxdo-note { display: block; margin-top: 0.45rem; color: var(--muted); font-size: 0.8rem; }

  /* ---- PoW 计算可视化：细线 + 等宽带 + 琥珀/绿状态色，与站点动效同语言 ---- */
  .linuxdo-pow { margin-top: 0.9rem; }
  .pow-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 0.45rem;
    font: 0.6rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .pow-target b {
    font-weight: 400;
    color: color-mix(in srgb, var(--accent-text) 75%, var(--muted));
    letter-spacing: 0.14em;
  }
  .pow-digits {
    display: flex;
    gap: 0.22rem;
    font: 0.78rem/1 var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .pow-digits span {
    flex: 1 1 0;
    min-width: 0;
    padding: 0.24rem 0;
    border-radius: var(--radius-panel);
    text-align: center;
    color: color-mix(in srgb, var(--muted) 50%, transparent);
    background: color-mix(in srgb, var(--muted) 7%, transparent);
    transition: color var(--t-fast) var(--ease), background-color var(--t-fast) var(--ease);
  }
  /* 前导零命中：琥珀点亮，是"接近目标"的即时反馈 */
  .pow-digits .pow-zero {
    color: var(--accent-text);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  /* 达到难度：转绿并锁定 */
  .pow-digits .pow-hit {
    color: var(--ok);
    background: color-mix(in srgb, var(--ok) 16%, transparent);
  }
  [data-state="running"] .pow-digits .pow-zero { animation: pow-tick 0.6s var(--ease) 1; }
  [data-state="solved"] .pow-digits { animation: pow-settle 380ms var(--ease) 1; }
  @keyframes pow-tick {
    0% { background: color-mix(in srgb, var(--accent) 45%, transparent); }
  }
  @keyframes pow-settle {
    0% { transform: translateY(1px); opacity: 0.7; }
    100% { transform: none; opacity: 1; }
  }
  .pow-rail {
    position: relative;
    height: 2px;
    margin-top: 0.5rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--muted) 22%, transparent);
  }
  /* 求解耗时不可预测，用不确定进度条，不假装百分比 */
  .pow-rail-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 34%;
    background: var(--accent-text);
    opacity: 0;
  }
  [data-state="running"] .pow-rail-fill {
    opacity: 0.85;
    animation: pow-sweep 1.15s var(--ease) infinite;
  }
  [data-state="solved"] .pow-rail-fill {
    width: 100%;
    opacity: 1;
    background: var(--ok);
    transition: width 260ms var(--ease), background-color 260ms var(--ease);
  }
  @keyframes pow-sweep {
    0% { transform: translateX(-110%); }
    100% { transform: translateX(400%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pow-rail-fill,
    [data-state="running"] .pow-rail-fill,
    [data-state="running"] .pow-digits .pow-zero,
    [data-state="solved"] .pow-digits {
      animation: none;
    }
    /* 无动画时保留静态可见的进行中提示 */
    [data-state="running"] .pow-rail-fill { width: 100%; opacity: 0.6; }
  }
</style>
