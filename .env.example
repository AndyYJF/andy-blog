# Copy to .env and fill in. Never commit real values.
WWW_ROOT=/var/www/andy-y.cn
DEPLOY_UID=1000
DEPLOY_GID=1000

# Digest-pin before production (replace REPLACE_WITH_PINNED_DIGEST).
NGINX_IMAGE=nginx:1.26-bookworm@sha256:REPLACE_WITH_PINNED_DIGEST
# Optional when switching Waline from build: to image:
# WALINE_IMAGE=lizheming/waline:1.x@sha256:REPLACE_WITH_PINNED_DIGEST

DB_HOST=mysql.example.internal
DB_NAME=typecho_db
TYPECHO_DB_HOST=mysql.example.internal
TYPECHO_DB_NAME=typecho_db
TYPECHO_RO_DB_USER=typecho_ro
TYPECHO_RO_DB_PASSWORD=replace-me

# Production Waline (public site plus protected management origin)
WALINE_MYSQL_HOST=mysql.example.internal
WALINE_MYSQL_PORT=3306
WALINE_MYSQL_DB=waline
WALINE_MYSQL_USER=waline
WALINE_MYSQL_PASSWORD=replace-me
WALINE_SECURE_DOMAINS=www.andy-y.cn,comments.andy-y.cn
WALINE_JWT=replace-with-long-random
AUTHOR_EMAIL=you@example.com
# SMTP_SERVICE=
# SMTP_USER=
# SMTP_PASS=

# Staging Waline (new.andy-y.cn — independent schema; never share production DB)
WALINE_STAGING_MYSQL_HOST=mysql.example.internal
WALINE_STAGING_MYSQL_PORT=3306
WALINE_STAGING_MYSQL_DB=waline_staging
WALINE_STAGING_MYSQL_USER=waline_staging
WALINE_STAGING_MYSQL_PASSWORD=replace-me
WALINE_STAGING_JWT=replace-with-different-long-random

# Dual CDN purge (leave unset until OpenAPI wired — scripts must not fake ok)
# ALIYUN_CDN_ACCESS_KEY_ID=
# ALIYUN_CDN_ACCESS_KEY_SECRET=
# ALIYUN_CDN_DOMAIN=
# CF_API_TOKEN=
# CF_ZONE_ID=

# Optional alert webhook (host/alert-notify.sh); unset → not-configured exit 71
# ALERT_WEBHOOK_URL=

# 1Panel staging adapter (compose.1panel-staging.yml only).
# Keep both image values pinned to tag@sha256 before deployment.
# WALINE_UPSTREAM_IMAGE=lizheming/waline:3.15.2@sha256:...
# WALINE_NODE_IMAGE=node:22.16.0-bookworm-slim@sha256:...
STAGING_WWW_ROOT=/opt/1panel/www/sites/new.andy-y.cn/deploy
WALINE_STAGING_HOST_PORT=8361
ONEPANEL_NETWORK=1panel-network

# 1Panel production Waline (compose.1panel-production.yml) — Stage 10 www cutover.
PROD_WWW_ROOT=/www/sites/www.andy-y.cn/deploy
WALINE_HOST_PORT=8360
WALINE_ADMIN_HOST_PORT=8362

# Article editing / automatic rebuild (compose.1panel-cms.yml).
REBUILD_RUNTIME_DIR=/var/www/andy-blog/runtime/build
REBUILD_SECRET_FILE=/var/www/andy-blog/secrets/webhook_secret
