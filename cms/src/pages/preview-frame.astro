---
const flow = Astro.url.searchParams.get('flow') || '';
const parent = Astro.url.searchParams.get('parent') || Astro.url.origin;
const nonce = Astro.locals.cspNonce || '';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>预览</title>
    <style>
      body { margin: 0; font: 16px/1.6 sans-serif; }
      .mermaid-pending { padding: 12px; border: 1px dashed currentColor; }
      pre { white-space: pre-wrap; }
    </style>
  </head>
  <body>
    <article id="root" class="prose reading-prose"></article>
    <script is:inline define:vars={{ flow, parent }} nonce={nonce}>
      const flowId = flow;
      const parentOrigin = parent;
      const root = document.getElementById('root');
      window.parent.postMessage({ type: 'cms-preview-ready', flowId }, parentOrigin);
      window.addEventListener('message', (event) => {
        if (event.origin !== parentOrigin) return;
        if (event.source !== window.parent) return;
        const data = event.data;
        if (!data || data.type !== 'cms-preview-html' || data.flowId !== flowId) return;
        root.innerHTML = data.html;
        window.parent.postMessage({ type: 'cms-preview-ack', flowId }, parentOrigin);
      });
    </script>
  </body>
</html>
