# Host path for compose.1panel-linuxdo.yml (not committed with real secrets).
# Example: /etc/andy-blog/linuxdo-invite.env
#
# Container runs as uid 1000 (node). After editing:
#   chown 1000:1000 /etc/andy-blog/linuxdo-invite.env && chmod 600 /etc/andy-blog/linuxdo-invite.env
#
# LINUXDO_INVITE_URL=https://linux.do/invites/REPLACE_ME
# LINUXDO_INVITE_NOTE=可选说明，最多约 120 字
# LINUXDO_POW_DIFFICULTY=4
#   leading zero hex digits for SHA-256(salt:nonce); 4 ≈ 1–2s on desktop

LINUXDO_INVITE_URL=https://linux.do/invites/REPLACE_ME
LINUXDO_INVITE_NOTE=
LINUXDO_POW_DIFFICULTY=4
